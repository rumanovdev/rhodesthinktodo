  <script is:inline>
    // Instagram has no share-a-link URL — the IG button copies the page link
    // so the user can paste it into a story, bio or DM.
    document.querySelectorAll('a[data-ig-copy]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        var url = el.getAttribute('href');
        if (navigator.clipboard && url) { navigator.clipboard.writeText(url).catch(function () {}); }
        var label = el.querySelector('.ig-label');
        if (label) {
          var prev = label.textContent;
          label.textContent = 'Link copied!';
          setTimeout(function () { label.textContent = prev; }, 2000);
        } else {
          var t = el.getAttribute('title');
          el.setAttribute('title', 'Link copied!');
          setTimeout(function () { el.setAttribute('title', t); }, 2000);
        }
      });
    });
  </script>

