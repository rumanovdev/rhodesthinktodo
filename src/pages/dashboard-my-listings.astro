---
import Base from '../layouts/Base.astro';
import Navbar from '../components/nav/Navbar.astro';
import LoginModal from '../components/shared/LoginModal.astro';
import SearchOffcanvas from '../components/shared/SearchOffcanvas.astro';
import Preloader from '../components/shared/Preloader.astro';
import DashboardSidebar from '../components/dashboard/DashboardSidebar.astro';
import { getListingsByOwner } from '../lib/supabase/listings';
export const prerender = false;

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase;
const myListings = await getListingsByOwner(supabase, user.id);

// Fetch current statuses + backlink state so we know which are drafts vs published.
const { data: statusRows } = supabase
  ? await supabase.from('listings').select('id, status, website, backlink_status').eq('owner_id', user.id)
  : { data: [] };
const statusById = new Map((statusRows ?? []).map((r: any) => [r.id, r.status]));
const backlinkById = new Map((statusRows ?? []).map((r: any) => [r.id, { website: r.website, status: r.backlink_status }]));
const anyMissingBacklink = (statusRows ?? []).some((r: any) => r.website && r.backlink_status !== 'verified');

const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
---
<Base noindex title="My Listings - Rhodes Things To Do">
  <Navbar headerClass="header header-light head-shadow" />

  <Preloader />

  <!-- Dashboard Start -->
  <section class="p-0">
    <div class="container-fluid p-0">
      <div class="row user-dashboard g-0 pt-lg-0 pt-5">

        <!-- Dashboard Sidebar -->
        <div class="col-xl-2 col-lg-3 col-md-12">
          <DashboardSidebar current="my-listings" />
        </div>

        <!-- Dashboard Content -->
        <div class="col-xl-10 col-lg-9 col-md-12">
          <div class="user-dashboard-box bg-light">

            <!-- Dashboard Title -->
            <div class="dashHeader p-xl-5 p-4 pb-xl-0 pb-0 d-flex align-items-center justify-content-between flex-wrap gap-3">
              <h2 class="fw-medium mb-0">My Listings</h2>
              <a href="/dashboard-add-listing/" class="btn btn-primary rounded-pill fw-medium"><i class="bi bi-plus-circle me-1"></i>Add Listing</a>
            </div>

            <!-- Dashboard Details -->
            <div class="dashCaption p-xl-5 p-3 p-md-4">

              {error && (
                <div class="alert alert-danger">{error}</div>
              )}
              {notice && (
                <div class="alert alert-success">{notice}</div>
              )}

              {anyMissingBacklink && (
                <div class="card rounded-4 shadow-sm border-warning border p-4 mb-4">
                  <div class="d-flex align-items-start gap-3 flex-wrap">
                    <div class="flex-grow-1" style="min-width:280px">
                      <h5 class="fw-semibold mb-1"><i class="bi bi-award text-warning me-2"></i>Keep your free listing — show our badge on your website</h5>
                      <p class="text-muted mb-3">Free listings ask for one thing: a link from your website back to ours. Easiest way — paste this badge in your footer or “About” page. It shows visitors you're featured here, and it counts as your backlink.</p>

                      <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                        <img src="/badge.svg" alt="Featured on Rhodes Things To Do" width="210" height="54" />
                        <span class="text-sm text-muted">← this is how it looks on your site</span>
                      </div>

                      <label class="form-label text-sm text-muted mb-1 mt-2">Copy this code into your website:</label>
                      <div class="d-flex gap-2 align-items-stretch">
                        <input type="text" readonly class="form-control font-monospace text-sm" id="badgeSnippet"
                          value={'<a href="https://rhodesthingstodo.com"><img src="https://rhodesthingstodo.com/badge.svg" alt="Featured on Rhodes Things To Do" width="210" height="54" style="border:0"></a>'} />
                        <button type="button" class="btn btn-primary rounded-pill px-3 copy-btn" data-copy="#badgeSnippet"><i class="bi bi-clipboard me-1"></i>Copy</button>
                      </div>

                      <details class="mt-3">
                        <summary class="text-primary fw-medium" style="cursor:pointer">Prefer a simple text link instead?</summary>
                        <div class="d-flex gap-2 align-items-stretch mt-2">
                          <input type="text" readonly class="form-control font-monospace text-sm" id="textSnippet"
                            value={'<a href="https://rhodesthingstodo.com">Rhodes Things To Do</a>'} />
                          <button type="button" class="btn btn-light border rounded-pill px-3 copy-btn" data-copy="#textSnippet"><i class="bi bi-clipboard me-1"></i>Copy</button>
                        </div>
                      </details>

                      <p class="text-sm text-muted mb-0 mt-3">
                        <strong>Where to paste it:</strong> WordPress — Appearance → Widgets → Footer → “Custom HTML” · Wix — Add (+) → Embed code · Squarespace — Footer → Code block.
                        Once it's on your site, press <strong>“Check backlink”</strong> on your listing below and the badge turns green.
                      </p>
                    </div>
                  </div>
                </div>
              )}

              <div class="row align-items-start g-4 mb-lg-5 mb-4">
                <div class="col-12">
                  <div class="card rounded-3 shadow-sm">
                    <div class="card-header px-4 py-3">
                      <h4 class="m-0">Manage Listings <span class="text-muted fs-6">({myListings.length})</span></h4>
                    </div>
                    <div class="card-body p-0">
                      {myListings.length === 0 ? (
                        <div class="p-4 text-center">
                          <p class="text-muted mb-3">You haven't created any listings yet.</p>
                          <a href="/dashboard-add-listing/" class="btn btn-primary rounded-pill fw-medium">Create your first listing</a>
                        </div>
                      ) : (
                        <ul class="dashboardListgroup">
                          {myListings.map((item) => {
                            const status = statusById.get(item.id) ?? 'draft';
                            return (
                              <li>
                                <div class="mngListings">
                                  <div class="d-flex align-items-center justify-content-start gap-3 flex-wrap">
                                    <div class="mngListinfirst">
                                      <div class="d-flex align-items-center justify-content-start gap-3 flex-wrap">
                                        <div class="mngListings-thumb">
                                          <figure class="m-0"><img src={item.img} class="img-fluid rounded" alt={item.title} /></figure>
                                        </div>
                                        <div class="mngListings-caps">
                                          <div class="d-flex align-items-center justify-content-start mb-1 gap-2 flex-wrap">
                                            {status === 'draft' && <span class="badge badge-xs bg-warning">Draft</span>}
                                            {status === 'published' && <span class="badge badge-xs bg-success">Published</span>}
                                            {status === 'archived' && <span class="badge badge-xs bg-secondary">Archived</span>}
                                            {backlinkById.get(item.id)?.website && (
                                              backlinkById.get(item.id)?.status === 'verified'
                                                ? <span class="badge badge-xs bg-success"><i class="bi bi-link-45deg me-1"></i>Backlink verified</span>
                                                : <span class="badge badge-xs bg-danger"><i class="bi bi-link-45deg me-1"></i>Backlink missing</span>
                                            )}
                                          </div>
                                          <h5 class="mnglstTitle"><a href={`/listing/${item.slug}/`}>{item.title}</a></h5>
                                          <span>{item.desc.slice(0, 140)}{item.desc.length > 140 ? '…' : ''}</span>
                                          <div class="d-flex align-items-center justify-content-start gap-2 mt-3">
                                            <div class="text-md text-muted">{item.city || 'No location'} · {item.reviews}</div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                    <div class="mngListinlast">
                                      <div class="d-flex align-items-center justify-content-start gap-2 flex-wrap">
                                        <a href={`/listing/${item.slug}/`} class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye me-1"></i>View</a>
                                        {backlinkById.get(item.id)?.website && backlinkById.get(item.id)?.status !== 'verified' && (
                                          <form action="/api/backlink-check" method="post" style="display:inline;">
                                            <input type="hidden" name="listing_id" value={item.id} />
                                            <button type="submit" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-link-45deg me-1"></i>Check backlink</button>
                                          </form>
                                        )}
                                        <form action={`/api/listings/${item.id}`} method="post" style="display:inline;">
                                          <input type="hidden" name="_action" value={status === 'published' ? 'unpublish' : 'publish'} />
                                          <button type="submit" class="btn btn-sm btn-light-success fw-medium rounded-pill">
                                            <i class="bi bi-check2-circle me-1"></i>{status === 'published' ? 'Unpublish' : 'Publish'}
                                          </button>
                                        </form>
                                        <form action={`/api/listings/${item.id}`} method="post" style="display:inline;" onsubmit="return confirm('Delete this listing permanently?')">
                                          <input type="hidden" name="_action" value="delete" />
                                          <button type="submit" class="btn btn-sm btn-light-danger fw-medium rounded-pill"><i class="bi bi-x me-1"></i>Delete</button>
                                        </form>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Row Start -->
              <div class="row align-items-start g-4">
                <div class="col-xl-12 col-lg-12 col-md-12">
                  <p class="text-muted m-0">&copy; <script is:inline>document.write(new Date().getFullYear())</script> Rhodes Things To Do.</p>
                </div>
              </div>

            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- Dashboard End -->


  <!-- Components/Home/index/search.html -->
  <SearchOffcanvas />


  <!-- Components/Home/index/log.html -->
  <LoginModal />

  <script>
    // Copy-to-clipboard for the backlink snippets.
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const input = document.querySelector<HTMLInputElement>(btn.dataset.copy || '');
        if (!input) return;
        try {
          await navigator.clipboard.writeText(input.value);
        } catch {
          input.select();
          document.execCommand('copy');
        }
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied!';
        setTimeout(() => { btn.innerHTML = original; }, 1600);
      });
    });
  </script>

</Base>
</content>
</invoke>