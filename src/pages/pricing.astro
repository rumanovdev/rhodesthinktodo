---
import Base from '../layouts/Base.astro';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/nav/Footer.astro';
import Subscribe from '../components/shared/Subscribe.astro';
import LoginModal from '../components/shared/LoginModal.astro';
import SearchOffcanvas from '../components/shared/SearchOffcanvas.astro';
import Preloader from '../components/shared/Preloader.astro';

const features = [
  {
    icon: 'bi bi-images',
    title: 'Your own listing page',
    desc: 'A dedicated page for your business with your photos, description, opening hours, contact details, an interactive map and visitor reviews.',
  },
  {
    icon: 'bi bi-grid-3x3-gap',
    title: 'Found by real visitors',
    desc: 'Your business appears in category and area browsing and in on-site search, so travellers planning their trip to Rhodes discover you.',
  },
  {
    icon: 'bi bi-calendar-check',
    title: 'Direct booking requests',
    desc: 'Enquiries and booking requests come straight to you — no middlemen and no commission ever taken on a single booking.',
  },
  {
    icon: 'bi bi-graph-up-arrow',
    title: 'An SEO-friendly page',
    desc: 'Each listing is built to be fast and search-friendly, giving your business a page that can rank and be found on Google.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Create a free account',
    desc: 'Sign up in a minute — no card, no fees, no subscription.',
    link: '/register/',
    cta: 'Create account',
  },
  {
    n: '2',
    title: 'Add your listing',
    desc: 'Fill in your details, upload your photos and choose your category and area.',
    link: '/dashboard-add-listing/',
    cta: 'Add listing',
  },
  {
    n: '3',
    title: 'We review & publish',
    desc: 'We check your listing, publish it live, and you add the link back to us from your website.',
    link: '/register/',
    cta: 'Get started',
  },
];

const badgeSnippet = '<a href="https://rhodesthingstodo.com"><img src="https://rhodesthingstodo.com/badge.svg" alt="Featured on Rhodes Things To Do"></a>';
---
<Base
  title="List Your Business Free — Rhodes Things To Do"
  description="Get your Rhodes business listed for free. No commissions, no fees — the only thing we ask is a link back to us."
  canonical="/pricing/"
>
  <Navbar headerClass="header header-light head-shadow" />

<Preloader />

<div class="clearfix"></div>

<!-- Page Title Start -->
<section class="bg-cover position-relative" style="background:url(/assets/img/title-banner.jpg)no-repeat;" data-overlay="6">
	<div class="container">
		<div class="row justify-content-center align-items-center pt-lg-0 pt-5">
			<div class="col-xl-9 col-lg-11 col-md-12 col-sm-12">
				<div class="position-relative text-center py-4">
					<span class="badge badge-xs badge-transparent rounded-pill mb-3">Free directory · No commissions</span>
					<h1 class="text-light xl-heading mb-3">List your business — for free</h1>
					<p class="text-light fs-5 opacity-75 mb-0">Get your Rhodes business in front of real visitors. No fees, no monthly plans and zero commission on your bookings. The only thing we ask is a link back to us.</p>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- Page Title End -->

<!-- What You Get Start -->
<section>
	<div class="container">

		<div class="row justify-content-center align-items-center">
			<div class="col-xl-8 col-lg-10 col-md-12 col-sm-12">
				<div class="secHeading-wrap text-center">
					<h2 class="sectionHeading">What you <span class="text-primary">get</span></h2>
					<p>Everything a business needs to be discovered on Rhodes — completely free.</p>
				</div>
			</div>
		</div>

		<div class="row justify-content-center g-4">
			{features.map((item) => (
			<div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
				<div class="card border rounded-4 h-100">
					<div class="card-body p-4 text-center">
						<div class="fs-1 text-primary mb-3"><i class={item.icon}></i></div>
						<h4 class="fw-medium mb-2">{item.title}</h4>
						<p class="m-0">{item.desc}</p>
					</div>
				</div>
			</div>
			))}
		</div>

	</div>
</section>
<!-- What You Get End -->

<!-- Backlink Start -->
<section class="bg-light">
	<div class="container">
		<div class="row justify-content-center align-items-center">
			<div class="col-xl-9 col-lg-10 col-md-12 col-sm-12">
				<div class="secHeading-wrap text-center mb-4">
					<h2 class="sectionHeading">All we ask: <span class="text-primary">one link back</span></h2>
					<p>We never charge you and we never take a commission. In return, we simply ask you to add a small "Featured on Rhodes Things To Do" link or badge somewhere on your own website. That link helps more travellers — and more search engines — find both of us.</p>
				</div>

				<div class="card border rounded-4">
					<div class="card-body p-4 p-md-5">
						<h5 class="fw-semibold mb-3">Your badge snippet</h5>
						<p>Paste this small snippet into your website's footer to display the badge and link:</p>
						<pre class="bg-dark text-light rounded-3 p-3 mb-3" style="overflow-x:auto;"><code>{badgeSnippet}</code></pre>
						<p class="m-0 text-muted">Prefer a plain text link? A ready-to-copy version — badge and link — is waiting in your dashboard as soon as you add a listing.</p>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>
<!-- Backlink End -->

<!-- How To Get Listed Start -->
<section>
	<div class="container">

		<div class="row justify-content-center align-items-center">
			<div class="col-xl-8 col-lg-10 col-md-12 col-sm-12">
				<div class="secHeading-wrap text-center">
					<h2 class="sectionHeading">How to get <span class="text-primary">listed</span></h2>
					<p>Three simple steps — and you are live.</p>
				</div>
			</div>
		</div>

		<div class="row justify-content-center g-md-5 g-4">
			{steps.map((item) => (
			<div class="col-xl-4 col-lg-4 col-md-6">
				<div class="processWrap px-xl-4">
					<div class="text-center">
						<div class="processIcons d-block">
							<div class="Icons"><span class="fw-bold">{item.n}</span></div>
						</div>
						<div class="processCaps">
							<h4 class="fw-medium">{item.title}</h4>
							<p class="mb-3">{item.desc}</p>
							<a href={item.link} class="btn btn-light-primary rounded-pill px-4 fw-medium">{item.cta}</a>
						</div>
					</div>
				</div>
			</div>
			))}
		</div>

	</div>
</section>
<!-- How To Get Listed End -->

<!-- Call To Action Start -->
<section class="pb-5">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-9 col-lg-10 col-md-12 col-sm-12">
				<div class="card border-0 rounded-4 bg-light">
					<div class="card-body text-center p-5">
						<h2 class="fw-semibold mb-2">Ready to get your business on the map?</h2>
						<p class="mb-4">It is free, it takes minutes, and there is never a commission on your bookings.</p>
						<div class="d-flex flex-wrap justify-content-center gap-3">
							<a href="/register/" class="btn btn-primary rounded-pill px-5 fw-medium">Create free account</a>
							<a href="/dashboard-add-listing/" class="btn btn-light-primary rounded-pill px-5 fw-medium">Add your listing</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- Call To Action End -->

	<!-- Components/Home/index/log.html -->
	<LoginModal />


	<!-- Components/Home/index/cart.html -->
	<!-- Components/Home/index/search.html -->
	<SearchOffcanvas />


	<Footer />
</Base>
