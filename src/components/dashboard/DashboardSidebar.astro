---
import { getMyProfile } from '../../lib/supabase/profiles';
import { countUnseenRequests } from '../../lib/supabase/requests';

interface Props {
  current: 'user' | 'my-profile' | 'requests' | 'calendar' | 'my-bookings' | 'my-listings' | 'bookmarks' | 'messages' | 'reviews' | 'wallet' | 'add-listing';
}
const { current } = Astro.props;

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
let fullName = 'Welcome';
let avatarUrl = '';
let unseenRequests = 0;
if (user && supabase) {
  const profile = await getMyProfile(supabase, user.id);
  fullName = profile?.full_name || user.email?.split('@')[0] || 'Account';
  avatarUrl = profile?.avatar_url || '';
  unseenRequests = await countUnseenRequests(supabase, user.id);
}
---
<style is:global>
  /* With the site footer removed from the dashboard, stretch the layout to the
     bottom of the viewport so no white strip shows under short pages. */
  .user-dashboard {
    min-height: calc(100vh - 75px); /* 75px = header height */
    align-items: stretch;
  }
  .user-dashboard .user-dashboard-box {
    min-height: 100%;
  }
</style>

<div class="user-dashboard-inner h-100 border-end border-2 py-4 p-3">
	<div class="dashboard_users mb-4">
		<div class="square--80 circle mx-auto mb-1" style="overflow:hidden;">
			{avatarUrl
				? <img src={avatarUrl} class="img-fluid circle" style="width:80px;height:80px;object-fit:cover;" alt={fullName} />
				: <span class="d-inline-flex align-items-center justify-content-center circle" style="width:80px;height:80px;background:rgba(255,255,255,.18);color:#fff;font-size:30px;font-weight:700;">{(fullName || '?').trim().split(/\s+/).map((w: string) => w[0]).slice(0, 2).join('').toUpperCase()}</span>}
		</div>
		<div class="user-nameTitle text-center">
			<h4 class="lh-base fw-semibold text-light mb-0">Welcome Back</h4>
			<h6 class="text-light fw-medium opacity-75 mb-0">{fullName}</h6>
		</div>
	</div>
	<div class="dashboard_Menu">
		<ul>
			<li><a href="/dashboard-user/" class={current === 'user' ? 'active' : ''}><i class="bi bi-speedometer me-2"></i>Dashboard Area</a></li>
			<li><a href="/dashboard-my-profile/" class={current === 'my-profile' ? 'active' : ''}><i class="bi bi-person-lines-fill me-2"></i>My Profile</a></li>
			<li><a href="/dashboard-requests/" class={current === 'requests' ? 'active' : ''}><i class="bi bi-bell me-2"></i>Requests{unseenRequests > 0 && <span class="badge bg-danger rounded-pill ms-2">{unseenRequests}</span>}</a></li>
			<li><a href="/dashboard-calendar/" class={current === 'calendar' ? 'active' : ''}><i class="bi bi-calendar3 me-2"></i>Calendar</a></li>
			<li><a href="/dashboard-my-bookings/" class={current === 'my-bookings' ? 'active' : ''}><i class="bi bi-journal-check me-2"></i>My Bookings</a></li>
			<li><a href="/dashboard-my-listings/" class={current === 'my-listings' ? 'active' : ''}><i class="bi bi-ui-radios-grid me-2"></i>My Listings</a></li>
			<li><a href="/dashboard-bookmarks/" class={current === 'bookmarks' ? 'active' : ''}><i class="bi bi-bookmark-star me-2"></i>Bookmarks</a></li>
			{/* Messages + Wallet are hidden in MVP (not yet wired to real data). Toggle back on once those features ship. */}
			<li><a href="/dashboard-reviews/" class={current === 'reviews' ? 'active' : ''}><i class="bi bi-yelp me-2"></i>Reviews</a></li>
			<li><a href="/dashboard-add-listing/" class={current === 'add-listing' ? 'active' : ''}><i class="bi bi-patch-plus me-2"></i>Add Listing</a></li>
		</ul>
	</div>
</div>
