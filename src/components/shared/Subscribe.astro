---
---
<style is:global>
  /* Newsletter band: keep the brand red, drop the white-dot pattern image */
  section.bg-primary-2 {
    background-image: none !important;
    background-color: var(--bs-primary) !important;
  }
</style>
<div class="row align-items-center justify-content-between g-4">

    <div class="col-xl-5 col-lg-5 col-md-5">
        <div class="callsTitles">
            <h4 class="text-white mb-0 lh-base">Get Rhodes tips in your inbox</h4>
            <p class="text-white opacity-75 m-0">New listings, beaches and local guides — straight to your email.</p>
        </div>
    </div>

    <div class="col-xl-5 col-lg-6 col-md-6">
        <form class="subscribeForm" action="mailto:info@rhodesthingstodo.com" method="post" enctype="text/plain">
            <div class="inputGroup">
                <input type="email" name="email" required class="form-control" placeholder="Your Email Here...">
                <button type="submit" class="btn btn-whites"><i class="fa-regular fa-paper-plane me-2"></i>Subscribe</button>
            </div>
        </form>
    </div>

</div>
