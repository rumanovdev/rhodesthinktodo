---
import type { ListingCard } from '../../lib/supabase/listings';
interface Props { item: ListingCard; }
const { item } = Astro.props;
---
<div class="fr-listing-cards listing-card5 lightshadow rounded-4 pb-0 h-100">
  <div class="fr-list-thumbs rounded-top-4">
    <a href={`/listing/${item.slug}/`}><img src={item.img} class="img-fluid rounded-top-4" alt={item.title} loading="lazy" /></a>
    {item.tag && (
      <div class="lis-wishlist"><span class="badge badge-xs bg-warning">Featured</span></div>
    )}
    <div class="position-absolute start-0 top-0 ms-3 mt-3">
      <span class={`badge badge-xs text-uppercase ${item.color === 'success' ? 'bg-success' : 'bg-primary'}`}>{item.btn}</span>
    </div>
  </div>
  <div class="fr-listing-content p-3">
    <div class="listingCats mb-1"><span class="text-md text-primary fw-medium">{item.name}</span></div>
    <h4 class="listingTitle"><a href={`/listing/${item.slug}/`} class="titleLink">{item.title}</a></h4>
    <div class="listingLocation text-md text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>{item.location || '—'}</div>
    <div class="listingMeta d-flex align-items-center justify-content-between mt-3">
      <div class="text-sm">{(parseInt(item.reviews) || 0) > 0
        ? (<><i class="bi bi-star-fill text-warning me-1"></i>{item.rating} · {item.reviews}</>)
        : (<span class="badge badge-xs bg-light-primary text-primary">New</span>)}</div>
      <div class="text-sm text-muted">{item.dollar}</div>
    </div>
  </div>
</div>

<style>
  /* Uniform card morphology: every card gets the same image ratio, the same
     space for title/location, and the rating row pinned to the bottom —
     regardless of how long the text is or what shape the photo was. */
  .fr-listing-cards {
    display: flex;
    flex-direction: column;
    overflow: hidden; /* keeps the image inside the rounded corners */
  }
  .fr-list-thumbs {
    position: relative; /* anchors the Featured/Verified badges */
    aspect-ratio: 4 / 3;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .fr-list-thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fr-listing-content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
  }
  .listingTitle {
    margin: 0;
    line-height: 1.3;
    min-height: 2.6em; /* always reserve two lines so short titles match long ones */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .listingLocation {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .listingMeta {
    margin-top: auto !important; /* pin ratings/price to the card bottom */
    padding-top: 0.75rem;
  }
</style>
